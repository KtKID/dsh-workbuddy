{
  "name": "dsh-workbuddy",
  "version": "0.2.0",
  "type": "module",
  "description": "在 DeepSeek Harness 中使用 WorkBuddy 桌面账号的模型、积分查询和工具调用",
  "bin": {
    "dsh-workbuddy-export": "scripts/export-runtime.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier src test scripts build.mjs tsconfig.json package.json eslint.config.mjs cordis.patch.yml locale README.md docs .github --check",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1 || ~4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.2-alpha.2"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@agentclientprotocol/sdk": "1.4.0",
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@eslint/js": "9.39.0",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "esbuild": "0.28.1",
    "eslint": "9.39.0",
    "prettier": "3.7.0",
    "react": "^18.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin",
        "linux"
      ]
    }
  },
  "license": "MIT",
  "author": "KtKID",
  "homepage": "https://github.com/KtKID/dsh-workbuddy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KtKID/dsh-workbuddy.git"
  },
  "bugs": {
    "url": "https://github.com/KtKID/dsh-workbuddy/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "workbuddy",
    "llm",
    "plugin"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
  "files": [
    "lib",
    "scripts/export-runtime.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ]
}
